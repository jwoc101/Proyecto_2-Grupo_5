// Reloj principal de la TangNano 9k
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Reset (Usando el botón S1 de la tarjeta)
IO_LOC  "reset" 3;
IO_PORT "reset" IO_TYPE=LVCMOS18;

// --- Teclado Hexadecimal ---
// Filas (Salidas: pines 79, 80, 81, 82)
IO_LOC  "row[0]" 79;
IO_PORT "row[0]" IO_TYPE=LVCMOS33;
IO_LOC  "row[1]" 80;
IO_PORT "row[1]" IO_TYPE=LVCMOS33;
IO_LOC  "row[2]" 81;
IO_PORT "row[2]" IO_TYPE=LVCMOS33;
IO_LOC  "row[3]" 82;
IO_PORT "row[3]" IO_TYPE=LVCMOS33;

// Columnas (Entradas con Pull-Down: pines 83, 84, 85, 86)
IO_LOC  "col[0]" 83;
IO_PORT "col[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "col[1]" 84;
IO_PORT "col[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "col[2]" 85;
IO_PORT "col[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "col[3]" 86;
IO_PORT "col[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- Display de 7 Segmentos ---
// Segmentos (gfedcba)
IO_LOC  "lit_segs[6]" 68;
IO_PORT "lit_segs[6]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_segs[5]" 56;
IO_PORT "lit_segs[5]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_segs[4]" 72;
IO_PORT "lit_segs[4]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_segs[3]" 71;
IO_PORT "lit_segs[3]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_segs[2]" 70;
IO_PORT "lit_segs[2]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_segs[1]" 55;
IO_PORT "lit_segs[1]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_segs[0]" 57;
IO_PORT "lit_segs[0]" IO_TYPE=LVCMOS33;

// Habilitación de los 4 dígitos (Ánodos/Cátodos comunes)
IO_LOC  "lit_digit[3]" 51;
IO_PORT "lit_digit[3]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_digit[2]" 53;
IO_PORT "lit_digit[2]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_digit[1]" 54;
IO_PORT "lit_digit[1]" IO_TYPE=LVCMOS33;
IO_LOC  "lit_digit[0]" 40;
IO_PORT "lit_digit[0]" IO_TYPE=LVCMOS33;
